<section id="inicio" class="hero-v2">

    <!-- ESCENARIO (desktop): imagen de fondo con bloques + textos HTML encima -->
    <div class="hero-v2-stage">

        <!-- Bloque superior: frase -->
        <div class="hero-v2-title">
            <p class="hero-v2-line1">¡Vive el mejor torneo</p>
            <p class="hero-v2-line2">del mundo mundial!</p>
        </div>

        <!-- Logo (solo mobile; en desktop viene en la imagen de fondo) -->
        <div class="hero-v2-logo lg:hidden">
            <img src="/images/logo-presentado.png?v={{timestamp}}" alt="Torneo Jorge Campos presentado por Nike">
        </div>

        <!-- Foto (solo mobile) -->
        <div class="hero-v2-photo lg:hidden">
            <img src="/images/hero-left.jpg?v={{timestamp}}" alt="Niños jugando futbol">
        </div>

        <!-- Bloque blanco: fecha y sede -->
        <div class="hero-v2-date">
            <p class="hero-v2-days">{{torneo.fechaInicio}}-{{torneo.fechaFin}}</p>
            <p class="hero-v2-month">Nov.{{torneo.año}}</p>
            <p class="hero-v2-city">{{torneo.sede.ciudad}}, Jal</p>
        </div>

    </div>

    <!-- BARRA INFERIOR -->
    <div class="hero-v2-bar">
        <div class="hero-v2-social">
            <a href="{{site.social.instagram}}" target="_blank" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="{{site.social.facebook}}" target="_blank" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="{{site.social.tiktok}}" target="_blank" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
            <a href="{{site.social.youtube}}" target="_blank" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
        </div>
        <div class="hero-v2-cats">
            <i class="fas fa-play"></i>
            <span>Categorías infantiles varonil y femenil</span>
            <i class="fas fa-play fa-flip-horizontal"></i>
        </div>
        <div class="hero-v2-chevrons" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
        </div>
    </div>

</section>
