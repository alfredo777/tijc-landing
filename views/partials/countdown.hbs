<section id="countdown" class="countdown-section relative bg-white text-gray-900 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-12">
            <p class="countdown-kicker text-rosa font-bold uppercase tracking-widest text-sm mb-2">Fecha del Torneo</p>
            <h2 class="countdown-fecha font-display text-5xl sm:text-6xl font-bold text-morado">
                {{torneo.fechaInicio}} - {{torneo.fechaFin}} <span class="text-rosa">{{torneo.mes}}</span>
            </h2>
        </div>

        <div id="countdownGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto">
            <div class="bg-morado text-white p-6 text-center">
                <span id="days" class="font-display text-5xl font-bold block">00</span>
                <span class="text-sm uppercase tracking-wider opacity-80">Días</span>
            </div>
            <div class="bg-morado text-white p-6 text-center">
                <span id="hours" class="font-display text-5xl font-bold block">00</span>
                <span class="text-sm uppercase tracking-wider opacity-80">Horas</span>
            </div>
            <div class="bg-morado text-white p-6 text-center">
                <span id="minutes" class="font-display text-5xl font-bold block">00</span>
                <span class="text-sm uppercase tracking-wider opacity-80">Minutos</span>
            </div>
            <div class="bg-morado text-white p-6 text-center">
                <span id="seconds" class="font-display text-5xl font-bold block">00</span>
                <span class="text-sm uppercase tracking-wider opacity-80">Segundos</span>
            </div>
        </div>

        {{!-- Se muestra cuando el contador llega a cero --}}
        <div id="countdownLive" class="countdown-live hidden">
            <p class="countdown-live-kicker"><i class="fas fa-futbol"></i> En vivo</p>
            <p class="countdown-live-line1">El mejor torneo del mundo mundial</p>
            <p class="countdown-live-line2">¡se está jugando!</p>
            <a href="/calendario-de-actividades" class="agenda-btn agenda-btn--primario mt-6">
                <i class="fas fa-calendar-alt"></i> Ver actividades
            </a>
        </div>
    </div>
</section>
