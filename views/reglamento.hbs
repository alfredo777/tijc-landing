{{!-- views/reglamento.hbs --}}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/favicon.png?v={{timestamp}}">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'rosa': '#E6007E',
                        'rosa-dark': '#C4006A',
                        'rosa-light': '#FF1493',
                        'dorado': '#FFD700',
                        'dorado-dark': '#DAA520',
                    },
                    fontFamily: {
                        'display': ['Bebas Neue', 'sans-serif'],
                        'body': ['Montserrat', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <!-- Estilos personalizados -->
    <link rel="stylesheet" href="/css/main.css?v={{timestamp}}">
</head>
<body class="font-body bg-gray-900 text-white">

    {{> navbar}}


<main class="pt-20">
    
    <!-- Header -->
    <section class="bg-gradient-to-r from-morado to-rosa py-16">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h1 class="text-4xl md:text-5xl font-display font-bold text-white mb-4">
                Reglamento del Torneo
            </h1>
            <p class="text-white/80">
                Última actualización: {{fechaActualizacion}}
            </p>
            <div class="mt-4 inline-flex items-center gap-2 bg-white/20 px-4 py-2 rounded-full">
                <i class="fas fa-futbol"></i>
                <span class="font-bold">Fútbol 7 y Fútbol 9</span>
            </div>
        </div>
    </section>

    <!-- Aviso tentativo -->
    <section class="bg-amarillo py-3">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <p class="text-black font-medium">
                <i class="fas fa-exclamation-circle mr-2"></i>
                <strong>Nota:</strong> Este reglamento es tentativo y puede sufrir modificaciones antes del inicio del torneo.
            </p>
        </div>
    </section>

    <!-- Navegación rápida -->
    <section class="py-6 bg-gray-100 sticky top-16 z-40 shadow-sm">
        <div class="max-w-4xl mx-auto px-4">
            <div class="flex flex-wrap justify-center gap-2 text-sm">
                <a href="#general" class="bg-morado text-white px-3 py-1 rounded-full hover:bg-morado/80 transition-colors">General</a>
                <a href="#categorias" class="bg-white text-morado px-3 py-1 rounded-full hover:bg-morado hover:text-white transition-colors border border-morado">Categorías</a>
                <a href="#fut7" class="bg-white text-morado px-3 py-1 rounded-full hover:bg-morado hover:text-white transition-colors border border-morado">Fut 7</a>
                <a href="#fut9" class="bg-white text-morado px-3 py-1 rounded-full hover:bg-morado hover:text-white transition-colors border border-morado">Fut 9</a>
                <a href="#jugadores" class="bg-white text-morado px-3 py-1 rounded-full hover:bg-morado hover:text-white transition-colors border border-morado">Jugadores</a>
                <a href="#partidos" class="bg-white text-morado px-3 py-1 rounded-full hover:bg-morado hover:text-white transition-colors border border-morado">Partidos</a>
                <a href="#sanciones" class="bg-white text-morado px-3 py-1 rounded-full hover:bg-morado hover:text-white transition-colors border border-morado">Sanciones</a>
            </div>
        </div>
    </section>

    <!-- Contenido -->
    <section class="py-12 bg-white">
        <div class="max-w-4xl mx-auto px-4">
            
            <div class="prose prose-lg max-w-none text-black">

                <!-- SECCIÓN: DISPOSICIONES GENERALES -->
                <div id="general" class="mb-12 scroll-mt-32">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="bg-morado text-white w-12 h-12 rounded-xl flex items-center justify-center">
                            <i class="fas fa-book text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-black m-0">Disposiciones Generales</h2>
                    </div>

                    <div class="bg-gradient-to-r from-morado/10 to-rosa/10 p-6 rounded-xl mb-6">
                        <p class="text-black m-0">
                            El <strong>Torneo Jorge Campos 2026</strong> es un evento deportivo de fútbol infantil que se rige bajo las reglas 
                            de la <strong>FIFA</strong> adaptadas para las modalidades de <strong>Fútbol 7</strong> y <strong>Fútbol 9</strong>, 
                            con las especificaciones particulares establecidas en este reglamento.
                        </p>
                    </div>

                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="bg-gray-50 p-5 rounded-xl">
                            <h3 class="font-bold text-black mb-3 flex items-center gap-2">
                                <i class="fas fa-flag text-morado"></i>
                                Objetivo
                            </h3>
                            <p class="text-black text-sm m-0">
                                Fomentar el desarrollo deportivo, social y humano de los niños y jóvenes a través del fútbol, 
                                promoviendo valores como el respeto, trabajo en equipo y fair play.
                            </p>
                        </div>
                        <div class="bg-gray-50 p-5 rounded-xl">
                            <h3 class="font-bold text-black mb-3 flex items-center gap-2">
                                <i class="fas fa-users text-morado"></i>
                                Autoridad
                            </h3>
                            <p class="text-black text-sm m-0">
                                El Comité Organizador es la máxima autoridad del torneo. Sus decisiones son inapelables 
                                en todos los asuntos relacionados con el evento.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN: CATEGORÍAS -->
                <div id="categorias" class="mb-12 scroll-mt-32">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="bg-morado text-white w-12 h-12 rounded-xl flex items-center justify-center">
                            <i class="fas fa-layer-group text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-black m-0">Categorías</h2>
                    </div>

                    <!-- Tabla de categorías -->
                    <div class="overflow-x-auto mb-6">
                        <table class="w-full border-collapse">
                            <thead>
                                <tr class="bg-morado text-white">
                                    <th class="p-3 text-left rounded-tl-xl">Categoría</th>
                                    <th class="p-3 text-center">Año Nacimiento</th>
                                    <th class="p-3 text-center">Modalidad</th>
                                    <th class="p-3 text-center rounded-tr-xl">Rama</th>
                                </tr>
                            </thead>
                            <tbody class="text-black">
                                <tr class="bg-blue-50">
                                    <td class="p-3 font-bold">Sub-7</td>
                                    <td class="p-3 text-center">2019 - 2020</td>
                                    <td class="p-3 text-center"><span class="bg-green-500 text-white px-2 py-1 rounded text-xs">Fut 7</span></td>
                                    <td class="p-3 text-center">Varonil / Femenil</td>
                                </tr>
                                <tr class="bg-white">
                                    <td class="p-3 font-bold">Sub-8</td>
                                    <td class="p-3 text-center">2018</td>
                                    <td class="p-3 text-center"><span class="bg-green-500 text-white px-2 py-1 rounded text-xs">Fut 7</span></td>
                                    <td class="p-3 text-center">Varonil / Femenil</td>
                                </tr>
                                <tr class="bg-blue-50">
                                    <td class="p-3 font-bold">Sub-9</td>
                                    <td class="p-3 text-center">2017</td>
                                    <td class="p-3 text-center"><span class="bg-green-500 text-white px-2 py-1 rounded text-xs">Fut 7</span></td>
                                    <td class="p-3 text-center">Varonil / Femenil</td>
                                </tr>
                                <tr class="bg-white">
                                    <td class="p-3 font-bold">Sub-10</td>
                                    <td class="p-3 text-center">2016</td>
                                    <td class="p-3 text-center"><span class="bg-green-500 text-white px-2 py-1 rounded text-xs">Fut 7</span></td>
                                    <td class="p-3 text-center">Varonil / Femenil</td>
                                </tr>
                                <tr class="bg-blue-50">
                                    <td class="p-3 font-bold">Sub-11</td>
                                    <td class="p-3 text-center">2015</td>
                                    <td class="p-3 text-center"><span class="bg-orange-500 text-white px-2 py-1 rounded text-xs">Fut 9</span></td>
                                    <td class="p-3 text-center">Varonil / Femenil</td>
                                </tr>
                                <tr class="bg-white">
                                    <td class="p-3 font-bold">Sub-12</td>
                                    <td class="p-3 text-center">2014</td>
                                    <td class="p-3 text-center"><span class="bg-orange-500 text-white px-2 py-1 rounded text-xs">Fut 9</span></td>
                                    <td class="p-3 text-center">Varonil / Femenil</td>
                                </tr>
                                <tr class="bg-blue-50">
                                    <td class="p-3 font-bold">Sub-13</td>
                                    <td class="p-3 text-center">2013</td>
                                    <td class="p-3 text-center"><span class="bg-orange-500 text-white px-2 py-1 rounded text-xs">Fut 9</span></td>
                                    <td class="p-3 text-center">Varonil / Femenil</td>
                                </tr>
                                <tr class="bg-white rounded-b-xl">
                                    <td class="p-3 font-bold rounded-bl-xl">Sub-14</td>
                                    <td class="p-3 text-center">2012</td>
                                    <td class="p-3 text-center"><span class="bg-orange-500 text-white px-2 py-1 rounded text-xs">Fut 9</span></td>
                                    <td class="p-3 text-center rounded-br-xl">Varonil / Femenil</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
                        <p class="text-black text-sm m-0">
                            <i class="fas fa-info-circle mr-2 text-yellow-600"></i>
                            <strong>Nota:</strong> Los jugadores pueden participar en una categoría superior a la que les corresponde por edad, 
                            pero <strong>nunca en una inferior</strong>. Esto debe solicitarse por escrito al Comité Organizador.
                        </p>
                    </div>
                </div>

                <!-- SECCIÓN: FÚTBOL 7 -->
                <div id="fut7" class="mb-12 scroll-mt-32">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="bg-green-500 text-white w-12 h-12 rounded-xl flex items-center justify-center">
                            <span class="font-bold text-xl">7</span>
                        </div>
                        <h2 class="text-3xl font-bold text-black m-0">Reglamento Fútbol 7</h2>
                    </div>

                    <p class="text-black mb-6">Aplica para categorías: <strong>Sub-7, Sub-8, Sub-9 y Sub-10</strong></p>

                    <div class="grid md:grid-cols-2 gap-6">
                        <!-- Campo de juego -->
                        <div class="bg-green-50 p-5 rounded-xl">
                            <h3 class="font-bold text-black mb-4 flex items-center gap-2">
                                <i class="fas fa-expand-arrows-alt text-green-600"></i>
                                Campo de Juego
                            </h3>
                            <ul class="space-y-2 text-black text-sm m-0 list-none p-0">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-ruler-horizontal text-green-600 mt-1"></i>
                                    <span><strong>Largo:</strong> 50 - 65 metros</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-ruler-vertical text-green-600 mt-1"></i>
                                    <span><strong>Ancho:</strong> 35 - 45 metros</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-square text-green-600 mt-1"></i>
                                    <span><strong>Área de meta:</strong> 9 x 18 metros</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-circle text-green-600 mt-1"></i>
                                    <span><strong>Punto penal:</strong> 9 metros</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Portería -->
                        <div class="bg-green-50 p-5 rounded-xl">
                            <h3 class="font-bold text-black mb-4 flex items-center gap-2">
                                <i class="fas fa-futbol text-green-600"></i>
                                Portería y Balón
                            </h3>
                            <ul class="space-y-2 text-black text-sm m-0 list-none p-0">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-arrows-alt-h text-green-600 mt-1"></i>
                                    <span><strong>Portería ancho:</strong> 5 metros</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-arrows-alt-v text-green-600 mt-1"></i>
                                    <span><strong>Portería alto:</strong> 2 metros</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-futbol text-green-600 mt-1"></i>
                                    <span><strong>Balón:</strong> No. 4</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Jugadores -->
                        <div class="bg-green-50 p-5 rounded-xl">
                            <h3 class="font-bold text-black mb-4 flex items-center gap-2">
                                <i class="fas fa-users text-green-600"></i>
                                Jugadores
                            </h3>
                            <ul class="space-y-2 text-black text-sm m-0 list-none p-0">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-green-600 mt-1"></i>
                                    <span><strong>En cancha:</strong> 7 (incluido portero)</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-green-600 mt-1"></i>
                                    <span><strong>Mínimo para iniciar:</strong> 5 jugadores</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-green-600 mt-1"></i>
                                    <span><strong>Cambios:</strong> Ilimitados (volantes)</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-green-600 mt-1"></i>
                                    <span><strong>Roster máximo:</strong> 14 jugadores</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Tiempo de juego -->
                        <div class="bg-green-50 p-5 rounded-xl">
                            <h3 class="font-bold text-black mb-4 flex items-center gap-2">
                                <i class="fas fa-clock text-green-600"></i>
                                Tiempo de Juego
                            </h3>
                            <ul class="space-y-2 text-black text-sm m-0 list-none p-0">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-stopwatch text-green-600 mt-1"></i>
                                    <span><strong>Duración:</strong> 2 tiempos de 20 minutos</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-pause text-green-600 mt-1"></i>
                                    <span><strong>Descanso:</strong> 5 minutos</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-hourglass-half text-green-600 mt-1"></i>
                                    <span><strong>Tiempo corrido:</strong> Sí (fase de grupos)</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Reglas especiales Fut 7 -->
                    <div class="mt-6 bg-green-100 p-5 rounded-xl">
                        <h3 class="font-bold text-black mb-4">
                            <i class="fas fa-star text-green-600 mr-2"></i>
                            Reglas Especiales Fut 7
                        </h3>
                        <div class="grid md:grid-cols-2 gap-4 text-sm text-black">
                            <div class="flex items-start gap-2">
                                <i class="fas fa-ban text-red-500 mt-1"></i>
                                <span><strong>No hay fuera de lugar (offside)</strong></span>
                            </div>
                            <div class="flex items-start gap-2">
                                <i class="fas fa-hand-paper text-green-600 mt-1"></i>
                                <span>El portero puede tomar el balón con las manos en toda el área</span>
                            </div>
                            <div class="flex items-start gap-2">
                                <i class="fas fa-undo text-green-600 mt-1"></i>
                                <span>Saque de banda puede ser con el pie</span>
                            </div>
                            <div class="flex items-start gap-2">
                                <i class="fas fa-running text-green-600 mt-1"></i>
                                <span>Barrera a 7 metros en tiros libres</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN: FÚTBOL 9 -->
                <div id="fut9" class="mb-12 scroll-mt-32">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="bg-orange-500 text-white w-12 h-12 rounded-xl flex items-center justify-center">
                            <span class="font-bold text-xl">9</span>
                        </div>
                        <h2 class="text-3xl font-bold text-black m-0">Reglamento Fútbol 9</h2>
                    </div>

                    <p class="text-black mb-6">Aplica para categorías: <strong>Sub-11, Sub-12, Sub-13 y Sub-14</strong></p>

                    <div class="grid md:grid-cols-2 gap-6">
                        <!-- Campo de juego -->
                        <div class="bg-orange-50 p-5 rounded-xl">
                            <h3 class="font-bold text-black mb-4 flex items-center gap-2">
                                <i class="fas fa-expand-arrows-alt text-orange-600"></i>
                                Campo de Juego
                            </h3>
                            <ul class="space-y-2 text-black text-sm m-0 list-none p-0">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-ruler-horizontal text-orange-600 mt-1"></i>
                                    <span><strong>Largo:</strong> 70 - 80 metros</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-ruler-vertical text-orange-600 mt-1"></i>
                                    <span><strong>Ancho:</strong> 45 - 55 metros</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-square text-orange-600 mt-1"></i>
                                    <span><strong>Área de meta:</strong> 12 x 30 metros</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-circle text-orange-600 mt-1"></i>
                                    <span><strong>Punto penal:</strong> 10 metros</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Portería -->
                        <div class="bg-orange-50 p-5 rounded-xl">
                            <h3 class="font-bold text-black mb-4 flex items-center gap-2">
                                <i class="fas fa-futbol text-orange-600"></i>
                                Portería y Balón
                            </h3>
                            <ul class="space-y-2 text-black text-sm m-0 list-none p-0">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-arrows-alt-h text-orange-600 mt-1"></i>
                                    <span><strong>Portería ancho:</strong> 6 metros</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-arrows-alt-v text-orange-600 mt-1"></i>
                                    <span><strong>Portería alto:</strong> 2.10 metros</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-futbol text-orange-600 mt-1"></i>
                                    <span><strong>Balón:</strong> No. 4 (Sub-11/12) / No. 5 (Sub-13/14)</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Jugadores -->
                        <div class="bg-orange-50 p-5 rounded-xl">
                            <h3 class="font-bold text-black mb-4 flex items-center gap-2">
                                <i class="fas fa-users text-orange-600"></i>
                                Jugadores
                            </h3>
                            <ul class="space-y-2 text-black text-sm m-0 list-none p-0">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-orange-600 mt-1"></i>
                                    <span><strong>En cancha:</strong> 9 (incluido portero)</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-orange-600 mt-1"></i>
                                    <span><strong>Mínimo para iniciar:</strong> 6 jugadores</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-orange-600 mt-1"></i>
                                    <span><strong>Cambios:</strong> Ilimitados (volantes)</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-orange-600 mt-1"></i>
                                    <span><strong>Roster máximo:</strong> 18 jugadores</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Tiempo de juego -->
                        <div class="bg-orange-50 p-5 rounded-xl">
                            <h3 class="font-bold text-black mb-4 flex items-center gap-2">
                                <i class="fas fa-clock text-orange-600"></i>
                                Tiempo de Juego
                            </h3>
                            <ul class="space-y-2 text-black text-sm m-0 list-none p-0">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-stopwatch text-orange-600 mt-1"></i>
                                    <span><strong>Duración:</strong> 2 tiempos de 25 minutos</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-pause text-orange-600 mt-1"></i>
                                    <span><strong>Descanso:</strong> 10 minutos</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-hourglass-half text-orange-600 mt-1"></i>
                                    <span><strong>Tiempo corrido:</strong> Sí (fase de grupos)</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Reglas especiales Fut 9 -->
                    <div class="mt-6 bg-orange-100 p-5 rounded-xl">
                        <h3 class="font-bold text-black mb-4">
                            <i class="fas fa-star text-orange-600 mr-2"></i>
                            Reglas Especiales Fut 9
                        </h3>
                        <div class="grid md:grid-cols-2 gap-4 text-sm text-black">
                            <div class="flex items-start gap-2">
                                <i class="fas fa-check text-orange-600 mt-1"></i>
                                <span><strong>Sí aplica fuera de lugar (offside)</strong></span>
                            </div>
                            <div class="flex items-start gap-2">
                                <i class="fas fa-hand-paper text-orange-600 mt-1"></i>
                                <span>Regla del pase atrás al portero aplica</span>
                            </div>
                            <div class="flex items-start gap-2">
                                <i class="fas fa-hands text-orange-600 mt-1"></i>
                                <span>Saque de banda con las manos</span>
                            </div>
                            <div class="flex items-start gap-2">
                                <i class="fas fa-running text-orange-600 mt-1"></i>
                                <span>Barrera a 9.15 metros en tiros libres</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN: JUGADORES Y EQUIPOS -->
                <div id="jugadores" class="mb-12 scroll-mt-32">
